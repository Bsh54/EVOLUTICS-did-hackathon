<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - CottonPay</title>

    <!-- Fira Code + Fira Sans Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600;700&family=Fira+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#16A34A',
                        secondary: '#22C55E',
                        cta: '#FBBF24',
                        background: '#F0FDF4',
                        text: '#14532D'
                    },
                    fontFamily: {
                        heading: ['Fira Code', 'monospace'],
                        body: ['Fira Sans', 'sans-serif']
                    },
                    borderRadius: {
                        'organic': '24px'
                    }
                }
            }
        }
    </script>

    <style>
        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
            }
        }

        body {
            font-family: 'Fira Sans', sans-serif;
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: 'Fira Code', monospace;
        }
    </style>
</head>
<body class="bg-background text-text antialiased">

    <!-- Top Navigation -->
    <nav class="fixed top-0 left-0 right-0 z-50 bg-white border-b border-primary/10">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                <!-- Logo -->
                <div class="flex items-center gap-3">
                    <svg class="size-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                    </svg>
                    <span class="font-heading text-xl font-bold text-primary">CottonPay</span>
                </div>

                <!-- User Info & Logout -->
                <div class="flex items-center gap-4">
                    <div class="text-right hidden sm:block">
                        <p class="text-sm font-medium text-text" id="userName">Chef de Coopérative</p>
                        <p class="text-xs text-text/60" id="userPhone">-</p>
                    </div>
                    <button onclick="handleLogout()" class="inline-flex items-center gap-2 px-4 py-2 bg-red-50 text-red-600 font-medium rounded-lg hover:bg-red-100 transition-colors duration-200 cursor-pointer">
                        <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                        </svg>
                        <span class="hidden sm:inline">Déconnexion</span>
                    </button>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="pt-20 pb-12 px-4 sm:px-6 lg:px-8">
        <div class="max-w-7xl mx-auto">

            <!-- Header -->
            <div class="mb-8">
                <h1 class="font-heading text-3xl sm:text-4xl font-bold text-text mb-2">
                    Tableau de bord
                </h1>
                <p class="text-text/70">
                    Gérez vos agriculteurs et leurs livraisons
                </p>
            </div>

            <!-- Stats Cards -->
            <div class="grid grid-cols-2 lg:grid-cols-5 gap-3 sm:gap-4 lg:gap-6 mb-8">
                <!-- Stat 1: Nombre d'agriculteurs -->
                <div class="bg-white rounded-organic p-3 sm:p-4 lg:p-6 border-2 border-primary/10 hover:border-primary/30 transition-colors duration-200">
                    <div class="flex flex-col gap-2 sm:gap-3">
                        <div class="size-8 sm:size-10 lg:size-12 bg-primary/10 rounded-lg flex items-center justify-center flex-shrink-0">
                            <svg class="size-4 sm:size-5 lg:size-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                            </svg>
                        </div>
                        <div class="flex-1 min-w-0">
                            <p class="text-xs text-text/60 mb-0.5">Agriculteurs</p>
                            <p class="font-heading text-xl sm:text-2xl lg:text-3xl font-bold text-text truncate" id="totalFarmers">0</p>
                        </div>
                    </div>
                </div>

                <!-- Stat 2: Total kilos vendus -->
                <div class="bg-white rounded-organic p-3 sm:p-4 lg:p-6 border-2 border-secondary/10 hover:border-secondary/30 transition-colors duration-200">
                    <div class="flex flex-col gap-2 sm:gap-3">
                        <div class="size-8 sm:size-10 lg:size-12 bg-secondary/10 rounded-lg flex items-center justify-center flex-shrink-0">
                            <svg class="size-4 sm:size-5 lg:size-6 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"/>
                            </svg>
                        </div>
                        <div class="flex-1 min-w-0">
                            <p class="text-xs text-text/60 mb-0.5">Total Kilos</p>
                            <p class="font-heading text-xl sm:text-2xl lg:text-3xl font-bold text-text truncate" id="totalWeight">0 <span class="text-sm sm:text-base lg:text-lg">kg</span></p>
                        </div>
                    </div>
                </div>

                <!-- Stat 3: Prix du kilo -->
                <div class="bg-white rounded-organic p-3 sm:p-4 lg:p-6 border-2 border-cta/10 hover:border-cta/30 transition-colors duration-200">
                    <div class="flex flex-col gap-2 sm:gap-3">
                        <div class="size-8 sm:size-10 lg:size-12 bg-cta/10 rounded-lg flex items-center justify-center flex-shrink-0">
                            <svg class="size-4 sm:size-5 lg:size-6 text-cta" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
                            </svg>
                        </div>
                        <div class="flex-1 min-w-0">
                            <p class="text-xs text-text/60 mb-0.5">Prix/kg</p>
                            <p class="font-heading text-xl sm:text-2xl lg:text-3xl font-bold text-text truncate" id="pricePerKg">250 <span class="text-sm sm:text-base lg:text-lg">FCFA</span></p>
                        </div>
                    </div>
                </div>

                <!-- Stat 4: Montant dû -->
                <div class="bg-white rounded-organic p-3 sm:p-4 lg:p-6 border-2 border-primary/10 hover:border-primary/30 transition-colors duration-200">
                    <div class="flex flex-col gap-2 sm:gap-3">
                        <div class="size-8 sm:size-10 lg:size-12 bg-primary/10 rounded-lg flex items-center justify-center flex-shrink-0">
                            <svg class="size-4 sm:size-5 lg:size-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                            </svg>
                        </div>
                        <div class="flex-1 min-w-0">
                            <p class="text-xs text-text/60 mb-0.5">Montant Dû</p>
                            <p class="font-heading text-lg sm:text-xl lg:text-2xl font-bold text-text truncate" id="amountDue">0 <span class="text-xs sm:text-sm lg:text-base">FCFA</span></p>
                        </div>
                    </div>
                </div>

                <!-- Stat 5: Montant total -->
                <div class="bg-white rounded-organic p-3 sm:p-4 lg:p-6 border-2 border-primary/10 hover:border-primary/30 transition-colors duration-200">
                    <div class="flex flex-col gap-2 sm:gap-3">
                        <div class="size-8 sm:size-10 lg:size-12 bg-primary/10 rounded-lg flex items-center justify-center flex-shrink-0">
                            <svg class="size-4 sm:size-5 lg:size-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                        </div>
                        <div class="flex-1 min-w-0">
                            <p class="text-xs text-text/60 mb-0.5">Montant Total</p>
                            <p class="font-heading text-lg sm:text-xl lg:text-2xl font-bold text-text truncate" id="totalAmount">0 <span class="text-xs sm:text-sm lg:text-base">FCFA</span></p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Action Buttons - Desktop only -->
            <div class="hidden lg:flex flex-row gap-4 mb-8">
                <button onclick="showRecordSaleModal()" class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-cta text-white font-semibold rounded-organic hover:bg-cta/90 transition-colors duration-200 cursor-pointer">
                    <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                    </svg>
                    <span class="whitespace-nowrap">Réaliser une vente</span>
                </button>
            </div>

            <!-- App Icons - Mobile/Tablet -->
            <div class="lg:hidden mb-8">
                <!-- Bouton principal centré -->
                <div class="flex justify-center mb-6">
                    <button onclick="showRecordSaleModal()" class="flex flex-col items-center gap-3 p-4 rounded-organic hover:bg-background transition-colors duration-200 cursor-pointer group">
                        <div class="size-24 sm:size-28 bg-gradient-to-br from-cta to-cta/80 rounded-organic shadow-2xl flex items-center justify-center group-hover:scale-105 transition-transform duration-200">
                            <svg class="size-12 sm:size-14 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
                            </svg>
                        </div>
                        <span class="text-base sm:text-lg font-semibold text-text text-center">Nouvelle vente</span>
                    </button>
                </div>

                <!-- 3 icônes secondaires -->
                <div class="grid grid-cols-3 gap-6 sm:gap-8 px-6 sm:px-12 max-w-2xl mx-auto">
                    <!-- Activités -->
                    <button onclick="showActivityFeedModal()" class="flex flex-col items-center gap-2 p-2 rounded-organic hover:bg-background transition-colors duration-200 cursor-pointer group">
                        <div class="size-16 sm:size-20 bg-gradient-to-br from-secondary to-secondary/80 rounded-organic shadow-lg flex items-center justify-center group-hover:scale-105 transition-transform duration-200">
                            <svg class="size-8 sm:size-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>
                            </svg>
                        </div>
                        <span class="text-xs sm:text-sm font-medium text-text text-center">Activités</span>
                    </button>

                    <!-- Gestion -->
                    <button onclick="showFarmersManagementModal()" class="flex flex-col items-center gap-2 p-2 rounded-organic hover:bg-background transition-colors duration-200 cursor-pointer group">
                        <div class="size-16 sm:size-20 bg-gradient-to-br from-primary to-primary/80 rounded-organic shadow-lg flex items-center justify-center group-hover:scale-105 transition-transform duration-200">
                            <svg class="size-8 sm:size-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                            </svg>
                        </div>
                        <span class="text-xs sm:text-sm font-medium text-text text-center">Gestion</span>
                    </button>

                    <!-- Usines -->
                    <button onclick="showFactorySalesModal()" class="flex flex-col items-center gap-2 p-2 rounded-organic hover:bg-background transition-colors duration-200 cursor-pointer group">
                        <div class="size-16 sm:size-20 bg-gradient-to-br from-primary to-primary/80 rounded-organic shadow-lg flex items-center justify-center group-hover:scale-105 transition-transform duration-200">
                            <svg class="size-8 sm:size-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                            </svg>
                        </div>
                        <span class="text-xs sm:text-sm font-medium text-text text-center">Usines</span>
                    </button>
                </div>
            </div>

            <!-- Farmers List - Desktop only -->
            <div class="hidden lg:block bg-white rounded-organic border-2 border-primary/10 overflow-hidden">
                <div class="p-4 sm:p-6 border-b border-primary/10">
                    <h2 class="font-heading text-xl font-bold text-text">
                        Liste des agriculteurs
                    </h2>
                </div>

                <!-- Desktop View -->
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead class="bg-background">
                            <tr>
                                <th class="px-6 py-3 text-left text-xs font-medium text-text/70 uppercase tracking-wider">Nom</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-text/70 uppercase tracking-wider">Téléphone</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-text/70 uppercase tracking-wider">Livraisons</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-text/70 uppercase tracking-wider">Total (kg)</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-text/70 uppercase tracking-wider">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="farmersTableBody" class="divide-y divide-primary/10">
                            <tr>
                                <td colspan="5" class="px-6 py-12 text-center text-text/60">
                                    Chargement...
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>

    <!-- Mobile Floating Action Button (FAB) - Hidden, using app icons instead -->

    <!-- Activity Feed Modal (Veille) -->
    <div id="activityFeedModal" class="hidden fixed inset-0 z-50 flex items-end lg:items-center justify-center bg-black/50 backdrop-blur-sm">
        <div class="bg-white rounded-t-organic lg:rounded-organic w-full lg:max-w-3xl lg:mx-4 max-h-[85vh] lg:max-h-[80vh] flex flex-col shadow-2xl border-t-2 lg:border-2 border-primary/10">
            <!-- Header -->
            <div class="flex items-center justify-between p-4 sm:p-6 border-b border-primary/10 flex-shrink-0">
                <h3 class="font-heading text-xl sm:text-2xl font-bold text-text">Activités récentes</h3>
                <button onclick="closeActivityFeedModal()" class="size-8 flex items-center justify-center rounded-lg hover:bg-background transition-colors duration-200 cursor-pointer">
                    <svg class="size-6 text-text/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>

            <!-- Content -->
            <div class="flex-1 overflow-y-auto p-4 sm:p-6" id="activityFeedContent">
                <div class="text-center py-12 text-text/60">
                    Chargement des activités...
                </div>
            </div>
        </div>
    </div>

    <!-- Farmers Management Modal (Gestion) -->
    <div id="farmersManagementModal" class="hidden fixed inset-0 z-50 flex items-end lg:items-center justify-center bg-black/50 backdrop-blur-sm">
        <div class="bg-white rounded-t-organic lg:rounded-organic w-full lg:max-w-4xl lg:mx-4 max-h-[85vh] lg:max-h-[80vh] flex flex-col shadow-2xl border-t-2 lg:border-2 border-primary/10">
            <!-- Header -->
            <div class="flex items-center justify-between p-4 sm:p-6 border-b border-primary/10 flex-shrink-0">
                <h3 class="font-heading text-xl sm:text-2xl font-bold text-text">Gestion des agriculteurs</h3>
                <button onclick="closeFarmersManagementModal()" class="size-8 flex items-center justify-center rounded-lg hover:bg-background transition-colors duration-200 cursor-pointer">
                    <svg class="size-6 text-text/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>

            <!-- Content -->
            <div class="flex-1 overflow-y-auto p-4 sm:p-6" id="farmersManagementContent">
                <div class="text-center py-12 text-text/60">
                    Chargement...
                </div>
            </div>
        </div>
    </div>

    <!-- Factory Sales Modal (Ventes aux usines) -->
    <div id="factorySalesModal" class="hidden fixed inset-0 z-50 flex items-end lg:items-center justify-center bg-black/50 backdrop-blur-sm">
        <div class="bg-white rounded-t-organic lg:rounded-organic w-full lg:max-w-2xl lg:mx-4 max-h-[85vh] lg:max-h-[80vh] flex flex-col shadow-2xl border-t-2 lg:border-2 border-primary/10">
            <!-- Header -->
            <div class="flex items-center justify-between p-4 sm:p-6 border-b border-primary/10 flex-shrink-0">
                <h3 class="font-heading text-xl sm:text-2xl font-bold text-text">Ventes aux usines</h3>
                <button onclick="closeFactorySalesModal()" class="size-8 flex items-center justify-center rounded-lg hover:bg-background transition-colors duration-200 cursor-pointer">
                    <svg class="size-6 text-text/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>

            <!-- Content -->
            <div class="flex-1 overflow-y-auto p-4 sm:p-6">
                <p class="text-center text-text/60 mb-6">Envoyer une demande de vente à l'usine d'égrenage</p>

                <div class="bg-background rounded-lg p-4 border border-primary/10 mb-6">
                    <h4 class="font-heading font-semibold text-text mb-3">Résumé de la coopérative</h4>
                    <div class="space-y-2 text-sm">
                        <div class="flex justify-between">
                            <span class="text-text/60">Total kilos disponibles:</span>
                            <span class="font-heading font-semibold text-text" id="factoryTotalKg">0 kg</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-text/60">Nombre d'agriculteurs:</span>
                            <span class="font-heading font-semibold text-text" id="factoryTotalFarmers">0</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-text/60">Montant total:</span>
                            <span class="font-heading font-semibold text-primary" id="factoryTotalAmount">0 FCFA</span>
                        </div>
                    </div>
                </div>

                <button onclick="sendFactorySaleRequest()" class="w-full inline-flex items-center justify-center gap-2 px-6 py-4 bg-primary text-white font-semibold rounded-organic hover:bg-primary/90 transition-colors duration-200 cursor-pointer">
                    <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
                    </svg>
                    Envoyer la demande
                </button>
            </div>
        </div>
    </div>

    <!-- Farmers List Modal -->
    <div id="farmersListModal" class="hidden fixed inset-0 z-50 flex items-end lg:items-center justify-center bg-black/50 backdrop-blur-sm">
        <div class="bg-white rounded-t-organic lg:rounded-organic w-full lg:max-w-4xl lg:mx-4 max-h-[85vh] lg:max-h-[80vh] flex flex-col shadow-2xl border-t-2 lg:border-2 border-primary/10">
            <!-- Header -->
            <div class="flex items-center justify-between p-4 sm:p-6 border-b border-primary/10 flex-shrink-0">
                <h3 class="font-heading text-xl sm:text-2xl font-bold text-text">Liste des agriculteurs</h3>
                <button onclick="closeFarmersListModal()" class="size-8 flex items-center justify-center rounded-lg hover:bg-background transition-colors duration-200 cursor-pointer">
                    <svg class="size-6 text-text/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>

            <!-- Content -->
            <div class="flex-1 overflow-y-auto p-4 sm:p-6" id="farmersListContent">
                <div class="text-center py-12 text-text/60">
                    Chargement...
                </div>
            </div>
        </div>
    </div>

    <!-- Stats Modal -->
    <div id="statsModal" class="hidden fixed inset-0 z-50 flex items-end lg:items-center justify-center bg-black/50 backdrop-blur-sm">
        <div class="bg-white rounded-t-organic lg:rounded-organic w-full lg:max-w-2xl lg:mx-4 max-h-[85vh] lg:max-h-[80vh] flex flex-col shadow-2xl border-t-2 lg:border-2 border-primary/10">
            <div class="flex items-center justify-between p-4 sm:p-6 border-b border-primary/10 flex-shrink-0">
                <h3 class="font-heading text-xl sm:text-2xl font-bold text-text">Statistiques détaillées</h3>
                <button onclick="closeStatsModal()" class="size-8 flex items-center justify-center rounded-lg hover:bg-background transition-colors duration-200 cursor-pointer">
                    <svg class="size-6 text-text/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>
            <div class="flex-1 overflow-y-auto p-4 sm:p-6">
                <p class="text-center text-text/60">Fonctionnalité en cours de développement...</p>
            </div>
        </div>
    </div>

    <!-- Reports Modal -->
    <div id="reportsModal" class="hidden fixed inset-0 z-50 flex items-end lg:items-center justify-center bg-black/50 backdrop-blur-sm">
        <div class="bg-white rounded-t-organic lg:rounded-organic w-full lg:max-w-2xl lg:mx-4 max-h-[85vh] lg:max-h-[80vh] flex flex-col shadow-2xl border-t-2 lg:border-2 border-primary/10">
            <div class="flex items-center justify-between p-4 sm:p-6 border-b border-primary/10 flex-shrink-0">
                <h3 class="font-heading text-xl sm:text-2xl font-bold text-text">Rapports</h3>
                <button onclick="closeReportsModal()" class="size-8 flex items-center justify-center rounded-lg hover:bg-background transition-colors duration-200 cursor-pointer">
                    <svg class="size-6 text-text/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>
            <div class="flex-1 overflow-y-auto p-4 sm:p-6">
                <p class="text-center text-text/60">Fonctionnalité en cours de développement...</p>
            </div>
        </div>
    </div>

    <!-- Settings Modal -->
    <div id="settingsModal" class="hidden fixed inset-0 z-50 flex items-end lg:items-center justify-center bg-black/50 backdrop-blur-sm">
        <div class="bg-white rounded-t-organic lg:rounded-organic w-full lg:max-w-2xl lg:mx-4 max-h-[85vh] lg:max-h-[80vh] flex flex-col shadow-2xl border-t-2 lg:border-2 border-primary/10">
            <div class="flex items-center justify-between p-4 sm:p-6 border-b border-primary/10 flex-shrink-0">
                <h3 class="font-heading text-xl sm:text-2xl font-bold text-text">Paramètres</h3>
                <button onclick="closeSettingsModal()" class="size-8 flex items-center justify-center rounded-lg hover:bg-background transition-colors duration-200 cursor-pointer">
                    <svg class="size-6 text-text/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>
            <div class="flex-1 overflow-y-auto p-4 sm:p-6">
                <p class="text-center text-text/60">Fonctionnalité en cours de développement...</p>
            </div>
        </div>
    </div>

    <!-- Mobile History Button - Hidden, using app icon instead -->

    <!-- History Modal -->
    <div id="historyModal" class="hidden fixed inset-0 z-50 flex items-end lg:items-center justify-center bg-black/50 backdrop-blur-sm">
        <div class="bg-white rounded-t-organic lg:rounded-organic w-full lg:max-w-2xl lg:mx-4 max-h-[85vh] lg:max-h-[80vh] flex flex-col shadow-2xl border-t-2 lg:border-2 border-primary/10">
            <!-- Header -->
            <div class="flex items-center justify-between p-4 sm:p-6 border-b border-primary/10 flex-shrink-0">
                <h3 class="font-heading text-xl sm:text-2xl font-bold text-text">Historique des ventes</h3>
                <button onclick="closeHistoryModal()" class="size-8 flex items-center justify-center rounded-lg hover:bg-background transition-colors duration-200 cursor-pointer">
                    <svg class="size-6 text-text/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>

            <!-- Content -->
            <div class="flex-1 overflow-y-auto p-4 sm:p-6" id="historyContent">
                <div class="text-center py-12 text-text/60">
                    Chargement de l'historique...
                </div>
            </div>
        </div>
    </div>

    <!-- Add Farmer Modal -->
    <div id="addFarmerModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm">
        <div class="bg-white rounded-organic p-8 max-w-md w-full mx-4 shadow-2xl border-2 border-primary/10">
            <div class="flex items-center justify-between mb-6">
                <h3 class="font-heading text-2xl font-bold text-text">Ajouter un agriculteur</h3>
                <button onclick="closeAddFarmerModal()" class="size-8 flex items-center justify-center rounded-lg hover:bg-background transition-colors duration-200 cursor-pointer">
                    <svg class="size-6 text-text/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>

            <div class="space-y-6">
                <div class="bg-background rounded-lg p-4 border-2 border-primary/10">
                    <div class="flex items-start gap-3">
                        <svg class="size-6 text-primary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        <div>
                            <p class="text-sm font-medium text-text mb-1">Authentification requise</p>
                            <p class="text-sm text-text/70">
                                L'agriculteur doit s'authentifier avec eSignet pour être enregistré dans le système.
                            </p>
                        </div>
                    </div>
                </div>

                <button id="authenticateBtn" onclick="authenticateFarmer()" class="w-full inline-flex items-center justify-center gap-2 px-6 py-4 bg-primary text-white font-semibold rounded-organic hover:bg-primary/90 transition-colors duration-200 cursor-pointer">
                    <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                    </svg>
                    Authentifier avec eSignet
                </button>

                <button onclick="closeAddFarmerModal()" class="w-full inline-flex items-center justify-center gap-2 px-6 py-4 bg-white text-text font-medium rounded-organic border-2 border-primary/20 hover:border-primary/40 transition-colors duration-200 cursor-pointer">
                    Annuler
                </button>
            </div>
        </div>
    </div>

    <!-- Record Sale Modal -->
    <div id="recordSaleModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm">
        <div class="bg-white rounded-organic p-8 max-w-md w-full mx-4 shadow-2xl border-2 border-primary/10">
            <div class="flex items-center justify-between mb-6">
                <h3 class="font-heading text-2xl font-bold text-text">Enregistrer une vente</h3>
                <button onclick="closeRecordSaleModal()" class="size-8 flex items-center justify-center rounded-lg hover:bg-background transition-colors duration-200 cursor-pointer">
                    <svg class="size-6 text-text/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>

            <form id="saleForm" onsubmit="submitSale(event)" class="space-y-6">
                <div>
                    <label for="farmerSelect" class="block text-sm font-medium text-text mb-2">
                        Agriculteur
                    </label>
                    <select id="farmerSelect" required class="w-full px-4 py-3 bg-background border-2 border-primary/10 rounded-lg focus:outline-none focus:border-primary transition-colors duration-200">
                        <option value="">Sélectionnez un agriculteur</option>
                    </select>
                </div>

                <div>
                    <label for="weight" class="block text-sm font-medium text-text mb-2">
                        Poids (kg)
                    </label>
                    <input type="number" id="weight" step="0.01" min="0" required oninput="calculateAmount()" class="w-full px-4 py-3 bg-background border-2 border-primary/10 rounded-lg focus:outline-none focus:border-primary transition-colors duration-200" placeholder="Ex: 150.5">
                </div>

                <div>
                    <label for="price" class="block text-sm font-medium text-text mb-2">
                        Prix par kg (FCFA)
                    </label>
                    <input type="number" id="price" step="1" min="0" required oninput="calculateAmount()" class="w-full px-4 py-3 bg-background border-2 border-primary/10 rounded-lg focus:outline-none focus:border-primary transition-colors duration-200" placeholder="Ex: 250">
                </div>

                <div class="bg-background rounded-lg p-4 border-2 border-primary/10">
                    <div class="flex items-center justify-between">
                        <span class="text-sm font-medium text-text">Montant total</span>
                        <span id="calculatedAmount" class="font-heading text-xl font-bold text-primary">0 FCFA</span>
                    </div>
                </div>

                <div class="flex gap-3">
                    <button type="button" onclick="closeRecordSaleModal()" class="flex-1 px-6 py-3 bg-white text-text font-medium rounded-organic border-2 border-primary/20 hover:border-primary/40 transition-colors duration-200 cursor-pointer">
                        Annuler
                    </button>
                    <button type="submit" id="submitSaleBtn" class="flex-1 px-6 py-3 bg-cta text-white font-semibold rounded-organic hover:bg-cta/90 transition-colors duration-200 cursor-pointer">
                        Enregistrer la vente
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        const API_URL = 'http://localhost:3002';

        // Load user info
        async function loadUserInfo() {
            try {
                const response = await fetch(`${API_URL}/user/profile`, {
                    credentials: 'include'
                });

                if (!response.ok) {
                    window.location.href = '/';
                    return;
                }

                const data = await response.json();
                const user = data.user;

                document.getElementById('userName').textContent = user.name || 'Chef de Coopérative';
                document.getElementById('userPhone').textContent = user.phone_number || '-';

            } catch (error) {
                console.error('Error loading user info:', error);
                window.location.href = '/';
            }
        }

        // Logout
        async function handleLogout() {
            try {
                await fetch(`${API_URL}/auth/logout`, {
                    method: 'POST',
                    credentials: 'include'
                });
                window.location.href = '/';
            } catch (error) {
                console.error('Logout error:', error);
            }
        }

        // Show Activity Feed Modal
        function showActivityFeedModal() {
            document.getElementById('activityFeedModal').classList.remove('hidden');
            loadActivityFeed();
        }

        // Close Activity Feed Modal
        function closeActivityFeedModal() {
            document.getElementById('activityFeedModal').classList.add('hidden');
        }

        // Load activity feed (ventes par jour)
        async function loadActivityFeed() {
            try {
                const content = document.getElementById('activityFeedContent');
                content.innerHTML = '<div class="text-center py-12 text-text/60">Chargement...</div>';

                console.log('Fetching sales history from:', `${API_URL}/sales/history`);

                const response = await fetch(`${API_URL}/sales/history`, {
                    credentials: 'include'
                });

                console.log('Response status:', response.status);

                if (!response.ok) {
                    const errorText = await response.text();
                    console.error('Error response:', errorText);
                    throw new Error(`Erreur ${response.status}: ${errorText}`);
                }

                const data = await response.json();
                console.log('Sales data received:', data);

                if (!data.sales || data.sales.length === 0) {
                    content.innerHTML = `
                        <div class="text-center py-12">
                            <svg class="size-16 mx-auto text-text/20 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                            </svg>
                            <p class="text-text/60">Aucune activité récente</p>
                        </div>
                    `;
                    return;
                }

                // Group by date
                const groupedByDate = {};
                data.sales.forEach(sale => {
                    const date = new Date(sale.created_at).toLocaleDateString('fr-FR', {
                        weekday: 'long',
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric'
                    });
                    if (!groupedByDate[date]) {
                        groupedByDate[date] = [];
                    }
                    groupedByDate[date].push(sale);
                });

                content.innerHTML = Object.keys(groupedByDate).map(date => `
                    <div class="mb-6 last:mb-0">
                        <h4 class="font-heading font-semibold text-text mb-3 capitalize sticky top-0 bg-white py-2">${date}</h4>
                        <div class="space-y-2">
                            ${groupedByDate[date].map(sale => `
                                <div class="bg-background rounded-lg p-3 border border-primary/10 flex items-center justify-between gap-3">
                                    <div class="flex-1 min-w-0">
                                        <p class="font-medium text-text truncate text-sm">${sale.farmer_name}</p>
                                        <p class="text-xs text-text/60">${new Date(sale.created_at).toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' })}</p>
                                    </div>
                                    <div class="flex items-center gap-3 flex-shrink-0">
                                        <span class="text-sm font-semibold text-text">${sale.weight_kg.toLocaleString('fr-FR')} kg</span>
                                        <span class="text-sm font-heading font-bold text-primary">${sale.total_amount.toLocaleString('fr-FR')} FCFA</span>
                                    </div>
                                </div>
                            `).join('')}
                        </div>
                    </div>
                `).join('');

            } catch (error) {
                console.error('Error loading activity feed:', error);
                document.getElementById('activityFeedContent').innerHTML = `
                    <div class="text-center py-12">
                        <svg class="size-16 mx-auto text-red-500 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        <p class="text-red-600 font-semibold mb-2">Erreur lors du chargement</p>
                        <p class="text-sm text-text/60">${error.message}</p>
                    </div>
                `;
            }
        }

        // Show Farmers Management Modal
        function showFarmersManagementModal() {
            document.getElementById('farmersManagementModal').classList.remove('hidden');
            loadFarmersManagement();
        }

        // Close Farmers Management Modal
        function closeFarmersManagementModal() {
            document.getElementById('farmersManagementModal').classList.add('hidden');
        }

        // Load farmers management
        async function loadFarmersManagement() {
            try {
                const content = document.getElementById('farmersManagementContent');
                content.innerHTML = '<div class="text-center py-12 text-text/60">Chargement...</div>';

                const response = await fetch(`${API_URL}/farmers`, {
                    credentials: 'include'
                });

                if (!response.ok) {
                    throw new Error('Erreur lors du chargement');
                }

                const data = await response.json();

                if (!data.farmers || data.farmers.length === 0) {
                    content.innerHTML = `
                        <div class="text-center py-12">
                            <svg class="size-16 mx-auto text-text/20 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                            </svg>
                            <p class="text-text/60">Aucun agriculteur enregistré</p>
                        </div>
                    `;
                    return;
                }

                content.innerHTML = `
                    <div class="space-y-3">
                        ${data.farmers.map(farmer => `
                            <button onclick="viewFarmerDetails('${farmer.id}')" class="w-full text-left bg-background rounded-lg p-4 border border-primary/10 hover:border-primary/30 transition-colors duration-200 cursor-pointer">
                                <div class="flex items-center gap-3 mb-2">
                                    <div class="size-12 bg-primary/10 rounded-lg flex items-center justify-center flex-shrink-0">
                                        <svg class="size-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                                        </svg>
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <p class="font-heading font-semibold text-text truncate">${farmer.name}</p>
                                        <p class="text-sm text-text/60">${farmer.phone_number}</p>
                                    </div>
                                    <svg class="size-5 text-text/40 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                                    </svg>
                                </div>
                                <div class="flex items-center gap-4 text-sm">
                                    <span class="text-text/60">${farmer.delivery_count || 0} livraisons</span>
                                    <span class="font-heading font-semibold text-text">${(farmer.total_weight || 0).toLocaleString('fr-FR')} kg</span>
                                </div>
                            </button>
                        `).join('')}
                    </div>
                `;

            } catch (error) {
                console.error('Error loading farmers:', error);
                document.getElementById('farmersManagementContent').innerHTML = `
                    <div class="text-center py-12 text-red-600">
                        <p>Erreur lors du chargement</p>
                    </div>
                `;
            }
        }

        // Show Factory Sales Modal
        function showFactorySalesModal() {
            document.getElementById('factorySalesModal').classList.remove('hidden');
            loadFactorySalesData();
        }

        // Close Factory Sales Modal
        function closeFactorySalesModal() {
            document.getElementById('factorySalesModal').classList.add('hidden');
        }

        // Load factory sales data
        async function loadFactorySalesData() {
            try {
                const response = await fetch(`${API_URL}/dashboard/stats`, {
                    credentials: 'include'
                });

                if (!response.ok) {
                    throw new Error('Erreur lors du chargement');
                }

                const data = await response.json();

                document.getElementById('factoryTotalKg').textContent = `${(data.totalWeight || 0).toLocaleString('fr-FR')} kg`;
                document.getElementById('factoryTotalFarmers').textContent = data.totalFarmers || '0';

                const PRICE_PER_KG = 250;
                const totalAmount = (data.totalWeight || 0) * PRICE_PER_KG;
                document.getElementById('factoryTotalAmount').textContent = `${totalAmount.toLocaleString('fr-FR')} FCFA`;

            } catch (error) {
                console.error('Error loading factory sales data:', error);
            }
        }

        // Send factory sale request
        async function sendFactorySaleRequest() {
            alert('Fonctionnalité en cours de développement - Demande de vente à l\'usine');
            // TODO: Implémenter l'envoi de la demande à l'usine d'égrenage
        }

        // Show Farmers List Modal
        function showFarmersListModal() {
            document.getElementById('farmersListModal').classList.remove('hidden');
            loadFarmersListModal();
        }

        // Close Farmers List Modal
        function closeFarmersListModal() {
            document.getElementById('farmersListModal').classList.add('hidden');
        }

        // Load farmers list in modal
        async function loadFarmersListModal() {
            try {
                const content = document.getElementById('farmersListContent');
                content.innerHTML = '<div class="text-center py-12 text-text/60">Chargement...</div>';

                const response = await fetch(`${API_URL}/farmers`, {
                    credentials: 'include'
                });

                if (!response.ok) {
                    throw new Error('Erreur lors du chargement des agriculteurs');
                }

                const data = await response.json();

                if (!data.farmers || data.farmers.length === 0) {
                    content.innerHTML = `
                        <div class="text-center py-12">
                            <svg class="size-16 mx-auto text-text/20 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                            </svg>
                            <p class="text-text/60">Aucun agriculteur enregistré</p>
                        </div>
                    `;
                    return;
                }

                content.innerHTML = `
                    <div class="space-y-3">
                        ${data.farmers.map(farmer => `
                            <div class="bg-background rounded-lg p-4 border border-primary/10">
                                <div class="flex items-start justify-between gap-3 mb-3">
                                    <div class="flex items-center gap-3 flex-1 min-w-0">
                                        <div class="size-12 bg-primary/10 rounded-lg flex items-center justify-center flex-shrink-0">
                                            <svg class="size-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                                            </svg>
                                        </div>
                                        <div class="flex-1 min-w-0">
                                            <p class="font-heading font-semibold text-text truncate">${farmer.name}</p>
                                            <p class="text-sm text-text/60">${farmer.phone_number}</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="flex items-center gap-4 text-sm">
                                    <div class="flex items-center gap-1.5">
                                        <svg class="size-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                                        </svg>
                                        <span class="font-medium text-text">${farmer.delivery_count || 0}</span>
                                        <span class="text-text/60">livraisons</span>
                                    </div>
                                    <div class="flex items-center gap-1.5">
                                        <svg class="size-4 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"/>
                                        </svg>
                                        <span class="font-heading font-semibold text-text">${(farmer.total_weight || 0).toLocaleString('fr-FR')} kg</span>
                                    </div>
                                </div>
                            </div>
                        `).join('')}
                    </div>
                `;

            } catch (error) {
                console.error('Error loading farmers:', error);
                document.getElementById('farmersListContent').innerHTML = `
                    <div class="text-center py-12 text-red-600">
                        <p>Erreur lors du chargement</p>
                    </div>
                `;
            }
        }

        // Show Stats Modal
        function showStatsModal() {
            document.getElementById('statsModal').classList.remove('hidden');
        }

        // Close Stats Modal
        function closeStatsModal() {
            document.getElementById('statsModal').classList.add('hidden');
        }

        // Show Reports Modal
        function showReportsModal() {
            document.getElementById('reportsModal').classList.remove('hidden');
        }

        // Close Reports Modal
        function closeReportsModal() {
            document.getElementById('reportsModal').classList.add('hidden');
        }

        // Show Settings Modal
        function showSettingsModal() {
            document.getElementById('settingsModal').classList.remove('hidden');
        }

        // Close Settings Modal
        function closeSettingsModal() {
            document.getElementById('settingsModal').classList.add('hidden');
        }
            document.getElementById('historyModal').classList.remove('hidden');
            loadHistory();
        }

        // Close History Modal
        function closeHistoryModal() {
            document.getElementById('historyModal').classList.add('hidden');
        }

        // Load history grouped by date
        async function loadHistory() {
            try {
                const historyContent = document.getElementById('historyContent');
                historyContent.innerHTML = '<div class="text-center py-12 text-text/60">Chargement...</div>';

                const response = await fetch(`${API_URL}/sales/history`, {
                    credentials: 'include'
                });

                if (!response.ok) {
                    throw new Error('Erreur lors du chargement de l\'historique');
                }

                const data = await response.json();

                if (!data.history || Object.keys(data.history).length === 0) {
                    historyContent.innerHTML = `
                        <div class="text-center py-12">
                            <svg class="size-16 mx-auto text-text/20 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                            </svg>
                            <p class="text-text/60">Aucune vente enregistrée</p>
                        </div>
                    `;
                    return;
                }

                // Group sales by date
                const groupedByDate = {};
                data.sales.forEach(sale => {
                    const date = new Date(sale.created_at).toLocaleDateString('fr-FR', {
                        weekday: 'long',
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric'
                    });
                    if (!groupedByDate[date]) {
                        groupedByDate[date] = [];
                    }
                    groupedByDate[date].push(sale);
                });

                // Render grouped history
                historyContent.innerHTML = Object.keys(groupedByDate).map(date => `
                    <div class="mb-6 last:mb-0">
                        <h4 class="font-heading font-semibold text-text mb-3 capitalize sticky top-0 bg-white py-2">${date}</h4>
                        <div class="space-y-3">
                            ${groupedByDate[date].map(sale => `
                                <div class="bg-background rounded-lg p-4 border border-primary/10">
                                    <div class="flex items-start justify-between gap-3 mb-3">
                                        <div class="flex items-center gap-3 flex-1 min-w-0">
                                            <div class="size-10 bg-primary/10 rounded-lg flex items-center justify-center flex-shrink-0">
                                                <svg class="size-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                                                </svg>
                                            </div>
                                            <div class="flex-1 min-w-0">
                                                <p class="font-medium text-text truncate">${sale.farmer_name}</p>
                                                <p class="text-xs text-text/60">${new Date(sale.created_at).toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' })}</p>
                                            </div>
                                        </div>
                                        <div class="text-right flex-shrink-0">
                                            <p class="font-heading font-bold text-primary text-lg">${sale.total_amount.toLocaleString('fr-FR')} FCFA</p>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-4 text-sm">
                                        <div class="flex items-center gap-1.5">
                                            <svg class="size-4 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"/>
                                            </svg>
                                            <span class="font-semibold text-text">${sale.weight_kg.toLocaleString('fr-FR')} kg</span>
                                        </div>
                                        <div class="flex items-center gap-1.5">
                                            <svg class="size-4 text-cta" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
                                            </svg>
                                            <span class="text-text/70">${sale.price_per_kg} FCFA/kg</span>
                                        </div>
                                    </div>
                                </div>
                            `).join('')}
                        </div>
                    </div>
                `).join('');

            } catch (error) {
                console.error('Error loading history:', error);
                document.getElementById('historyContent').innerHTML = `
                    <div class="text-center py-12 text-red-600">
                        <p>Erreur lors du chargement de l'historique</p>
                    </div>
                `;
            }
        }

        // Show Record Sale Modal
        function showRecordSaleModal() {
            loadFarmersForSale();
            document.getElementById('recordSaleModal').classList.remove('hidden');
        }

        // Close Record Sale Modal
        function closeRecordSaleModal() {
            document.getElementById('recordSaleModal').classList.add('hidden');
            document.getElementById('saleForm').reset();
            document.getElementById('calculatedAmount').textContent = '0 FCFA';
        }

        // Load farmers list for sale dropdown
        async function loadFarmersForSale() {
            try {
                const response = await fetch(`${API_URL}/farmers`, {
                    credentials: 'include'
                });

                if (!response.ok) {
                    throw new Error('Erreur lors du chargement des agriculteurs');
                }

                const data = await response.json();
                const select = document.getElementById('farmerSelect');
                select.innerHTML = '<option value="">Sélectionnez un agriculteur</option>';

                data.farmers.forEach(farmer => {
                    const option = document.createElement('option');
                    option.value = farmer.id;
                    option.textContent = `${farmer.name} - ${farmer.phone_number}`;
                    select.appendChild(option);
                });

            } catch (error) {
                console.error('Error loading farmers:', error);
            }
        }

        // Calculate amount based on weight and price
        function calculateAmount() {
            const weight = parseFloat(document.getElementById('weight').value) || 0;
            const price = parseFloat(document.getElementById('price').value) || 0;
            const amount = weight * price;
            document.getElementById('calculatedAmount').textContent = `${amount.toLocaleString('fr-FR')} FCFA`;
        }

        // Submit sale record
        async function submitSale(event) {
            event.preventDefault();

            const farmerId = document.getElementById('farmerSelect').value;
            const weight = parseFloat(document.getElementById('weight').value);
            const price = parseFloat(document.getElementById('price').value);

            if (!farmerId || !weight || !price) {
                alert('Veuillez remplir tous les champs');
                return;
            }

            try {
                const btn = document.getElementById('submitSaleBtn');
                btn.disabled = true;
                btn.innerHTML = '<svg class="animate-spin size-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>Enregistrement...';

                const response = await fetch(`${API_URL}/sales`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    credentials: 'include',
                    body: JSON.stringify({
                        farmer_id: farmerId,
                        weight_kg: weight,
                        price_per_kg: price
                    })
                });

                if (!response.ok) {
                    throw new Error('Erreur lors de l\'enregistrement');
                }

                const data = await response.json();
                alert('Vente enregistrée avec succès!');
                closeRecordSaleModal();
                loadDashboardData();

            } catch (error) {
                console.error('Error recording sale:', error);
                alert('Erreur lors de l\'enregistrement de la vente');
            } finally {
                const btn = document.getElementById('submitSaleBtn');
                btn.disabled = false;
                btn.innerHTML = 'Enregistrer la vente';
            }
        }

        // Load dashboard data
        async function loadDashboardData() {
            try {
                // Prix fixe du kilo
                const PRICE_PER_KG = 250;

                const response = await fetch(`${API_URL}/dashboard/stats`, {
                    credentials: 'include'
                });

                if (!response.ok) {
                    throw new Error('Erreur lors du chargement des données');
                }

                const data = await response.json();

                // Nombre d'agriculteurs authentifiés
                document.getElementById('totalFarmers').textContent = data.totalFarmers || '0';

                // Total kilos vendus
                const totalWeight = parseFloat(data.totalWeight) || 0;
                document.getElementById('totalWeight').innerHTML = `${totalWeight.toLocaleString('fr-FR')} <span class="text-base sm:text-lg">kg</span>`;

                // Prix du kilo (fixe)
                document.getElementById('pricePerKg').innerHTML = `${PRICE_PER_KG} <span class="text-base sm:text-lg">FCFA</span>`;

                // Montant dû (prix × kilos)
                const amountDue = totalWeight * PRICE_PER_KG;
                document.getElementById('amountDue').innerHTML = `${amountDue.toLocaleString('fr-FR')} <span class="text-sm sm:text-base">FCFA</span>`;

                // Montant total (même valeur que montant dû)
                document.getElementById('totalAmount').innerHTML = `${amountDue.toLocaleString('fr-FR')} <span class="text-sm sm:text-base">FCFA</span>`;

                await loadFarmersList();

            } catch (error) {
                console.error('Error loading dashboard data:', error);
            }
        }

        // Load farmers list
        async function loadFarmersList() {
            try {
                const response = await fetch(`${API_URL}/farmers`, {
                    credentials: 'include'
                });

                if (!response.ok) {
                    throw new Error('Erreur lors du chargement des agriculteurs');
                }

                const data = await response.json();

                // Desktop table
                const tbody = document.getElementById('farmersTableBody');

                // Mobile list
                const mobileList = document.getElementById('farmersMobileList');

                if (!data.farmers || data.farmers.length === 0) {
                    tbody.innerHTML = `
                        <tr>
                            <td colspan="5" class="px-6 py-12 text-center text-text/60">
                                Aucun agriculteur enregistré. Cliquez sur "Ajouter un agriculteur" pour commencer.
                            </td>
                        </tr>
                    `;
                    mobileList.innerHTML = `
                        <div class="px-4 py-8 text-center text-text/60 text-sm">
                            Aucun agriculteur enregistré. Cliquez sur "Ajouter un agriculteur" pour commencer.
                        </div>
                    `;
                    return;
                }

                // Desktop view
                tbody.innerHTML = data.farmers.map(farmer => `
                    <tr class="hover:bg-background transition-colors duration-200">
                        <td class="px-6 py-4 whitespace-nowrap">
                            <div class="flex items-center gap-3">
                                <div class="size-10 bg-primary/10 rounded-lg flex items-center justify-center flex-shrink-0">
                                    <svg class="size-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                                    </svg>
                                </div>
                                <div>
                                    <p class="font-medium text-text">${farmer.name}</p>
                                </div>
                            </div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-text/70">${farmer.phone_number}</td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <span class="inline-flex items-center px-3 py-1 bg-primary/10 text-primary rounded-full text-sm font-medium">
                                ${farmer.delivery_count || 0}
                            </span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap font-heading font-semibold text-text">
                            ${(farmer.total_weight || 0).toLocaleString('fr-FR')} kg
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <button onclick="viewFarmerDetails('${farmer.id}')" class="inline-flex items-center gap-2 px-4 py-2 bg-background text-primary font-medium rounded-lg hover:bg-primary/10 transition-colors duration-200 cursor-pointer">
                                <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                </svg>
                                Voir
                            </button>
                        </td>
                    </tr>
                `).join('');

                // Mobile view
                mobileList.innerHTML = data.farmers.map(farmer => `
                    <div class="p-4 hover:bg-background transition-colors duration-200">
                        <div class="flex items-start gap-3 mb-3">
                            <div class="size-12 bg-primary/10 rounded-lg flex items-center justify-center flex-shrink-0">
                                <svg class="size-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                                </svg>
                            </div>
                            <div class="flex-1 min-w-0">
                                <p class="font-heading font-semibold text-text mb-1">${farmer.name}</p>
                                <p class="text-sm text-text/60 mb-2">${farmer.phone_number}</p>
                                <div class="flex items-center gap-3 text-sm">
                                    <span class="inline-flex items-center gap-1">
                                        <svg class="size-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                                        </svg>
                                        <span class="font-medium text-text">${farmer.delivery_count || 0}</span>
                                        <span class="text-text/60">livraisons</span>
                                    </span>
                                    <span class="inline-flex items-center gap-1">
                                        <svg class="size-4 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"/>
                                        </svg>
                                        <span class="font-heading font-semibold text-text">${(farmer.total_weight || 0).toLocaleString('fr-FR')} kg</span>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <button onclick="viewFarmerDetails('${farmer.id}')" class="w-full inline-flex items-center justify-center gap-2 px-4 py-2 bg-background text-primary font-medium rounded-lg hover:bg-primary/10 transition-colors duration-200 cursor-pointer">
                            <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                            </svg>
                            Voir les détails
                        </button>
                    </div>
                `).join('');

            } catch (error) {
                console.error('Error loading farmers list:', error);
            }
        }

        // View farmer details
        function viewFarmerDetails(farmerId) {
            alert(`Détails de l'agriculteur ${farmerId} - Fonctionnalité en cours de développement`);
            // TODO: Implémenter la page de détails de l'agriculteur
        }

        // Initialize
        document.addEventListener('DOMContentLoaded', () => {
            loadUserInfo();
            loadDashboardData();
        });
    </script>

</body>
</html>