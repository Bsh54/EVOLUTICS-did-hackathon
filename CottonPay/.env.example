# CottonPay Configuration

# Application
NODE_ENV=development
APP_PORT=3002
APP_URL=http://localhost:3002
FRONTEND_URL=http://localhost:3001

# Session
SESSION_SECRET=change-this-to-a-random-secret-in-production

# eidStack-CMU Configuration (émission/vérification de credentials + login wallet)
EIDSTACK_URL=http://localhost:4000

# Mock Identity System (pour tests, résolution NPI)
MOCK_IDENTITY_URL=http://localhost:8082

# Espace admin d'enrôlement (protégé par cette clé)
ADMIN_KEY=change-this-admin-key

# Logging
LOG_LEVEL=debug
