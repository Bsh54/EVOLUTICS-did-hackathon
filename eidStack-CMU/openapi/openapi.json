  "info": {
    "title": "e-ID REST API",
    "description": "REST APIs converted from GraphQL",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "InitAgentDto": {
        "type": "object",
        "properties": {
          "walletId": {
            "type": "string"
          },
          "walletKey": {
            "type": "string"
          },
          "endpoint": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "seed": {
            "type": "string"
          }
        },
        "required": [
          "walletId",
          "walletKey",
          "endpoint",
          "label",
          "seed"
        ]
      },
      "ReceiveInvitationDto": {
        "type": "object",
        "properties": {
          "invitationUrl": {
            "type": "string",
            "description": "Out-of-band invitation URL"
          }
        },
        "required": [
          "invitationUrl"
        ]
      },
      "CreateShortUrlDto": {
        "type": "object",
        "properties": {
          "originalUrl": {
            "type": "string"
          }
        },
        "required": [
          "originalUrl"
        ]
      },
      "AttributeInput": {
        "type": "object",
        "properties": {
          "attributeName": {
            "type": "string"
          },
          "schemaDataType": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          }
        },
        "required": [
          "attributeName",
          "schemaDataType",
          "displayName"
        ]
      },
      "CreateSchemaInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "attributes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AttributeInput"
            }
          },
          "issuerId": {
            "type": "string"
          },
          "orgId": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "version",
          "attributes"
        ]
      },
      "CreateCredDefInput": {
        "type": "object",
        "properties": {
          "schemaId": {
            "type": "string"
          },
          "tag": {
            "type": "string"
          },
          "supportRevocation": {
            "type": "boolean"
          }
        },
        "required": [
          "schemaId",
          "tag"
        ]
      },
      "CredentialAttributeInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "value"
        ]
      },
      "OfferCredentialWithUrlDto": {
        "type": "object",
        "properties": {
          "credentialDefinitionId": {
            "type": "string"
          },
          "connectionId": {
            "type": "string"
          },
          "attributes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CredentialAttributeInput"
            }
          },
          "comment": {
            "type": "string"
          }
        },
        "required": [
          "credentialDefinitionId"
        ]
      },
      "RestrictionDto": {
        "type": "object",
        "properties": {
          "schema": {
            "type": "object",
            "description": "Schema filter / predicate"
          },
          "credDefId": {
            "type": "object",
            "description": "Credential definition id filter"
          }
        }
      },
      "AttributeRequestDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Attribute name to request (e.g. email, given_name)"
          },
          "restrictions": {
            "description": "Optional array of restrictions (schema, credDefId)",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RestrictionDto"
            }
          }
        },
        "required": [
          "name"
        ]
      },
      "PredicateRequestDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Predicate attribute name"
          },
          "pType": {
            "type": "string",
            "description": "pType (e.g. '>=', '<=', '>')"
          },
          "pValue": {
            "type": "number",
            "description": "predicate value"
          }
        },
        "required": [
          "name",
          "pType",
          "pValue"
        ]
      },
      "ProofRequestDto": {
        "type": "object",
        "properties": {
          "credDefId": {
            "type": "string",
            "description": "Credential definition id used for this proof request"
          },
          "attributes": {
            "description": "Attributes to request",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AttributeRequestDto"
            }
          },
          "predicates": {
            "description": "Optional predicates",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PredicateRequestDto"
            }
          },
          "comment": {
            "type": "string",
            "description": "Optional comment to include in proof request"
          },
          "connectionId": {
            "type": "string",
            "description": "Optional connectionId if request should be connection-based"
          }
        },
        "required": [
          "credDefId",
          "attributes"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "correlationId": {
            "type": "string"
          },
          "statusCode": {
            "type": "integer",
            "format": "int32"
          },
          "error": {
            "type": "string"
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array"
              },
              {
                "type": "object"
              }
            ]
          }
        }
      }
    }
  }
}