<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <title>SSI Invite</title>
</head>
<body style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial; padding:16px; background:#f2f2f2;">
  <div style="max-width:700px; margin:0 auto; background:#fff; padding:20px; border-radius:8px;">
    <img src="https://bharatblockchain.io/wp-content/uploads/2022/04/cropped-bbn-logo.png" width="220" />

    <p>Dear {{name}},</p>

    <p>You have received an invite to connect to SSI Wallet.</p>

    <!-- ✅ Connect to App button -->
    <a
      href="{{invitePayload}}"
      style="display:inline-block; padding:12px 16px; background:#2f80ed; color:#fff; text-decoration:none; border-radius:6px; font-weight:600;"
    >
      Connect to App
    </a>

    <p style="font-size:13px; color:#555; margin-top:16px;">
      If the button doesn't work, copy & paste this deep link in mobile browser:
    </p>

    <p style="word-break:break-all; font-size:13px;">
      {{invitePayload}}
    </p>

    <hr style="margin: 25px 0; border: none; border-top: 1px solid #eee;" />

    <!-- ✅ QR Code -->
    <h3 style="margin: 0 0 10px;">Scan QR Code (Recommended)</h3>
    <p style="font-size:13px; color:#555;">
      If you opened this email on laptop, scan below QR code using your mobile camera/QR scanner.
    </p>

    <div style="text-align:center; margin-top:10px;">
      <img src="{{qrCode}}" alt="QR Code" width="220" height="220"
        style="border:1px solid #eee; padding:8px; border-radius:8px;" />
      <p style="font-size:12px; color:#777; margin-top:8px;">
        Scan to open in SSI Wallet App
      </p>
    </div>

    <p style="font-weight:600; margin-top:40px;">
      Warm Regards,<br/>
      De-Id Team
    </p>
  </div>
</body>
</html>
